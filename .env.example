# NEAR Agent — environment variables
# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Mock mode is the default: no real funds move.

# Execution mode: mock | oneclick | testnet
# Default is "mock". Live modes run ONLY when NEAR_MODE is set explicitly.
NEAR_MODE=mock

# NEAR Intents (1Click API) — for NEAR_MODE=oneclick.
# A JWT is OPTIONAL: without one, calls work unauthenticated (extra 0.25% fee).
# See https://docs.near-intents.org/
ONECLICK_JWT=

# NEAR testnet account — required for NEAR_MODE=testnet.
NEAR_TESTNET_ACCOUNT_ID=
NEAR_TESTNET_PRIVATE_KEY=

# OpenAI API key for LLM intent parsing (optional).
# If unset, the built-in rule-based parser is used instead.
OPENAI_API_KEY=

# Model used for intent parsing (only used when OPENAI_API_KEY is set).
OPENAI_MODEL=gpt-4o-mini

# HTTP port for the local server.
PORT=3001
